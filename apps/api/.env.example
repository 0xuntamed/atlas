# ── ATLAS API environment ──
# Copy to `apps/api/.env` (Prisma + the API server both read this file).

# Matches docker-compose.yml (host port 5433 to avoid clashing with a
# native Postgres that may already own 5432).
DATABASE_URL="postgresql://atlas:atlas@localhost:5433/atlas?schema=public"

API_PORT=4000
NODE_ENV=development

# Where the web app runs (used for CORS)
WEB_ORIGIN="http://localhost:3000"

# Auth: "mock" (default) resolves every request to a dev user with no external
# setup. Switch to "clerk" when you add real keys below.
AUTH_MODE=mock

# ── Clerk ── (https://dashboard.clerk.com) — required only when AUTH_MODE=clerk
# CLERK_SECRET_KEY="sk_test_..."
# Your Clerk Frontend API URL, e.g. https://your-app-12.clerk.accounts.dev
# CLERK_ISSUER="https://your-app.clerk.accounts.dev"

# ── Discovery providers ──
# REST Countries + Open-Meteo are keyless. Places uses OpenTripMap when a key
# is present, otherwise a keyless mock. "auto" (default) picks automatically.
PLACES_PROVIDER=auto
# OPENTRIPMAP_API_KEY="..."   # https://opentripmap.io/product

# ── Production knobs (safe defaults; override when deploying) ──
# NODE_ENV=production            # JSON logs instead of pretty
# WEB_ORIGIN="https://a.com,https://b.com"   # comma-separated for multiple
# LOG_LEVEL=info                 # fatal|error|warn|info|debug|trace
# RATE_LIMIT_MAX=100             # requests per window per IP (/health exempt)
# RATE_LIMIT_WINDOW="1 minute"
# TRUST_PROXY=true               # enable behind a load balancer / proxy
# APP_VERSION=1.0.0              # surfaced by GET /health
# SENTRY_DSN="https://...@sentry.io/..."   # optional error monitoring
