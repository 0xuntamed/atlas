// ATLAS database schema.
// PostgreSQL owns all user-generated application state. External APIs
// (REST Countries, OpenTripMap, Open-Meteo) are discovery sources only and are
// never modelled here — we only snapshot the few fields we need (see externalPlaceId).

generator client {
  provider = "prisma-client-js"
  // "native" for local dev; the musl target is for the Alpine Docker image.
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TripStatus {
  DRAFT
  PLANNED
  ACTIVE
  COMPLETED
  CANCELLED
}

enum ExpenseCategory {
  FLIGHT
  HOTEL
  FOOD
  TRANSPORT
  ACTIVITY
  SHOPPING
  OTHER
}

model User {
  id        String   @id @default(cuid())
  // Identity is owned by Clerk; this mirrors the Clerk user id.
  clerkId   String   @unique
  name      String?
  email     String?  @unique
  avatar    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  trips            Trip[]
  savedPlaces      SavedPlace[]
  visitedCountries VisitedCountry[]
}

model Trip {
  id          String     @id @default(cuid())
  userId      String
  title       String
  countryCode String // ISO 3166-1 alpha-2
  startDate   DateTime?
  endDate     DateTime?
  status      TripStatus @default(DRAFT)
  coverImage  String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  days     TripDay[]
  expenses Expense[]

  @@index([userId])
  @@index([userId, status])
}

model TripDay {
  id       String    @id @default(cuid())
  tripId   String
  date     DateTime?
  title    String?
  notes    String?
  position Int       @default(0)

  trip   Trip        @relation(fields: [tripId], references: [id], onDelete: Cascade)
  places TripPlace[]

  @@index([tripId])
}

model TripPlace {
  id              String  @id @default(cuid())
  tripDayId       String
  externalPlaceId String? // reference into a discovery provider (nullable for manual entries)
  name            String
  latitude        Float?
  longitude       Float?
  category        String?
  position        Int     @default(0)
  notes           String?

  tripDay TripDay @relation(fields: [tripDayId], references: [id], onDelete: Cascade)

  @@index([tripDayId])
}

model SavedPlace {
  id              String   @id @default(cuid())
  userId          String
  externalPlaceId String?
  name            String
  countryCode     String?
  latitude        Float?
  longitude       Float?
  category        String?
  createdAt       DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // A given external place should only be saved once per user.
  @@unique([userId, externalPlaceId])
  @@index([userId])
}

model Expense {
  id          String          @id @default(cuid())
  tripId      String
  amount      Decimal         @db.Decimal(12, 2)
  currency    String          @default("USD")
  category    ExpenseCategory @default(OTHER)
  description String?
  createdAt   DateTime        @default(now())

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@index([tripId])
}

model VisitedCountry {
  id             String    @id @default(cuid())
  userId         String
  countryCode    String
  firstVisitedAt DateTime?
  lastVisitedAt  DateTime?
  visitCount     Int       @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, countryCode])
  @@index([userId])
}
