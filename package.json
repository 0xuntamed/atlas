{
  "name": "atlas",
  "version": "0.1.0",
  "private": true,
  "description": "ATLAS — Personal Travel World Map",
  "packageManager": "pnpm@10.30.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:generate": "pnpm --filter @atlas/api prisma generate",
    "db:migrate": "pnpm --filter @atlas/api prisma migrate dev",
    "db:deploy": "pnpm --filter @atlas/api prisma migrate deploy",
    "db:studio": "pnpm --filter @atlas/api prisma studio",
    "db:seed": "pnpm --filter @atlas/api db:seed",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\""
  },
  "devDependencies": {
    "prettier": "^3.4.2",
    "turbo": "^2.5.0",
    "typescript": "^5.7.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@clerk/shared",
      "@prisma/client",
      "@prisma/engines",
      "esbuild",
      "prisma",
      "sharp",
      "unrs-resolver"
    ]
  }
}
